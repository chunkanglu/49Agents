# tailnet.env — sourced by 49ctl at the end of load_config().
#
# Purpose: make a self-hosted instance reachable by tailnet peers with no
# per-machine configuration. Everything here is derived at run time, so this
# file is identical on every machine and safe to commit.
#
# Why it exists at all:
#   * cloud/src/config.js binds HOST or 0.0.0.0. Binding every interface also
#     publishes the server on café wifi, client LANs, and any hotel network,
#     which is rarely what a "share it with my team" setup intends.
#   * Pinning HOST to the tailnet address removes 127.0.0.1 from the listening
#     set, so AGENT_CLOUD_URL must move with it or the agent dials loopback and
#     loops forever on WebSocket 1006.
# Those two values must agree, so they are computed together, here, once.
#
# `./49ctl setup` rewrites .49agents/config with four lines and would drop any
# hand-added exports. It never touches this file, so the settings survive.

# --- locate the tailscale CLI ------------------------------------------------
# PATH on macOS usually lacks it: the App Store and standalone builds keep the
# binary inside the app bundle, Homebrew puts it in its own prefix.
_49_find_tailscale() {
  # Explicit override wins and suppresses the search, so an unusual install
  # location can be pointed at directly — and so the no-CLI path is testable.
  if [ -n "${TAILSCALE_BIN:-}" ]; then
    [ -x "${TAILSCALE_BIN}" ] && { printf '%s' "${TAILSCALE_BIN}"; return; }
    return 1
  fi
  if command -v tailscale >/dev/null 2>&1; then command -v tailscale; return; fi
  for _c in \
    /Applications/Tailscale.app/Contents/MacOS/Tailscale \
    /usr/local/bin/tailscale \
    /opt/homebrew/bin/tailscale \
    /usr/bin/tailscale
  do
    [ -x "$_c" ] && { printf '%s' "$_c"; return; }
  done
  return 1
}

# --- find this machine's tailnet address -------------------------------------
# Tailscale always assigns from the CGNAT range 100.64.0.0/10, i.e. second
# octet 64-127. Checking that range matters: plenty of LANs use 100.x outside
# it, and binding to one of those would silently defeat the point.
_49_tailnet_ip() {
  _ts="$(_49_find_tailscale 2>/dev/null)"
  if [ -n "$_ts" ]; then
    _ip="$("$_ts" ip -4 2>/dev/null | head -1 | tr -d '[:space:]')"
    [ -n "$_ip" ] && { printf '%s' "$_ip"; return; }
  fi

  # Fallback with no CLI: read the interfaces directly. Covers a running
  # tailscaled whose CLI we could not locate.
  if command -v ifconfig >/dev/null 2>&1; then
    _ip="$(ifconfig 2>/dev/null | awk '/inet 100\./ {print $2}' \
      | awk -F. '$2 >= 64 && $2 <= 127 {print; exit}')"
  else
    _ip="$(ip -4 -o addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1 \
      | awk -F. '$1 == 100 && $2 >= 64 && $2 <= 127 {print; exit}')"
  fi
  [ -n "$_ip" ] && { printf '%s' "$_ip"; return; }
  return 1
}

_49_TAILNET_IP="$(_49_tailnet_ip 2>/dev/null)"

# Only touch the network settings when the cloud server runs HERE. In the
# multi-machine layout (`setup` -> 2 -> "Agent only") the server lives on
# someone else's machine and AGENT_CLOUD_URL is the address of THAT machine —
# rewriting it to this host's own tailnet IP would point the agent at a port
# with nothing behind it.
if [ "${RUN_CLOUD:-true}" != "true" ]; then
  : # agent-only: keep the configured AGENT_CLOUD_URL, set no HOST
elif [ -n "$_49_TAILNET_IP" ]; then
  export HOST="$_49_TAILNET_IP"
  AGENT_CLOUD_URL="ws://${_49_TAILNET_IP}:${CLOUD_PORT}"
else
  # No tailnet address. Fail closed on loopback rather than inheriting the
  # upstream 0.0.0.0 default, which would expose a shell-spawning service on
  # whatever network this machine happens to be on.
  export HOST=127.0.0.1
  AGENT_CLOUD_URL="ws://127.0.0.1:${CLOUD_PORT}"
  echo "  [tailnet.env] No 100.64.0.0/10 address found — binding 127.0.0.1 (local only)." >&2
  echo "  [tailnet.env] Start Tailscale and restart to make this reachable by teammates." >&2
fi

# --- run without a 49agents.com account --------------------------------------
# Without this, cloud/src/auth/agentAuth.js:84 refuses to let the agent start
# until you have signed in through https://app.49agents.com, which writes a
# cloud user id and token into the local_auth table. The flag is the project's
# own documented escape hatch (agentAuth.js:66, middleware.js:107).
#
# Consequence, stated plainly: every request is auto-authenticated as a single
# "dev-user". There is no per-person login, so anyone who can reach
# ${HOST}:${CLOUD_PORT} gets a terminal on this machine as the user running it.
# The trust boundary is the tailnet and its ACLs, not the application.
export SKIP_CLOUD_AUTH=1

# --- per-machine JWT secrets --------------------------------------------------
# cloud/src/config.js otherwise falls back to the published literals
# 'dev-secret-change-in-production' / 'dev-agent-secret-change-in-production',
# which anyone can use to forge tokens. Generated once per machine and cached
# outside version control.
_49_SECRETS_FILE="${STATE_DIR:-$(dirname "${BASH_SOURCE[0]}")/.49agents}/secrets"
if [ ! -f "$_49_SECRETS_FILE" ]; then
  mkdir -p "$(dirname "$_49_SECRETS_FILE")"
  {
    echo "export JWT_SECRET=$(openssl rand -hex 32)"
    echo "export AGENT_JWT_SECRET=$(openssl rand -hex 32)"
  } > "$_49_SECRETS_FILE"
  chmod 600 "$_49_SECRETS_FILE"
fi
# shellcheck source=/dev/null
. "$_49_SECRETS_FILE"

unset -f _49_find_tailscale _49_tailnet_ip 2>/dev/null || true
unset _49_TAILNET_IP _49_SECRETS_FILE _ts _ip _c 2>/dev/null || true
